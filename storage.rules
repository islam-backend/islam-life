rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Avatars — any signed-in team member can view; a member can only
    // write to their own path, images only, capped at 2MB.
    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
          && request.auth.uid == uid
          && request.resource.size < 2 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // Task chat image attachments — any signed-in team member can view
    // and upload (images only, capped at 5MB). Fine-grained "is this
    // person on the task" is enforced by firestore.rules on the comment
    // doc that references the image, not here.
    match /taskImages/{clientId}/{projectId}/{taskId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
