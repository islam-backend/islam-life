rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Avatars — any signed-in team member can view; a member can only
    // write to their own path, images only, capped at 2MB.
    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
          && request.auth.uid == uid
          && request.resource.size < 2 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // (Task chat images are resized client-side and stored inline in the
    // Firestore comment doc as a data: URL — no Storage object, so no rule
    // needed here. See src/lib/image.ts.)
  }
}
