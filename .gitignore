# Firebase web config is public by design — the apiKey is NOT a secret.
# Real security comes from Firestore Rules (see firestore.rules).
# So firebase-config.js IS committed to the repo so GitHub Pages can load it.

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Daily-report script — local secrets/deps must NEVER be committed
scripts/node_modules/
scripts/serviceAccount.json
scripts/.env

# Serena (local coding-assistant cache — not shared)
.serena/

# Vite / Node (added for the new task-manager frontend)
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Android (Capacitor) — build output and machine-specific files
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
# Tied to one Firebase project's Android app registration (package name +
# SHA-1 + OAuth client) — same reasoning as firebase-config.json above:
# each deployment gets its own, so it isn't baked into the repo.
android/app/google-services.json
*.apk
*.aab

# Cloudflare Worker (push-relay) local state — secrets live in Cloudflare,
# never in the repo. See worker/push-relay/README.md.
worker/push-relay/.wrangler/
worker/push-relay/.dev.vars
