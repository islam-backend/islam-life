rules_version = '2';

// ════════════════════════════════════════════════════════════════
//  Firestore Security Rules — islam.walied dashboard
// ════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: only the owner is allowed ──
    function isOwner() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email == 'islam.walied96@gmail.com';
    }

    // ── Helper: shared project access (read/write tasks only) ──
    function hasShareAccess(clientId, projectId) {
      let shareId = clientId + '_' + projectId;
      return request.auth != null
          && exists(/databases/$(database)/documents/shares/$(shareId))
          && get(/databases/$(database)/documents/shares/$(shareId)).data.email == request.auth.token.email;
    }

    // ── Share links collection ──
    match /shares/{shareId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // ── Direct paths ──
    match /clients/{clientId} {
      allow read, write: if isOwner();

      match /projects/{projectId} {
        allow read: if isOwner() || hasShareAccess(clientId, projectId);
        allow write: if isOwner();

        match /tasks/{taskId} {
          allow read, write: if isOwner() || hasShareAccess(clientId, projectId);
        }
      }
    }

    // ── Finance Hub ──
    match /envelopes/{envId}  { allow read, write: if isOwner(); }
    match /incomes/{incomeId} { allow read, write: if isOwner(); }
    match /expenses/{expId}   { allow read, write: if isOwner(); }
    match /transfers/{trId}   { allow read, write: if isOwner(); }
    match /sources/{srcId}    { allow read, write: if isOwner(); }
    match /meta/{docId}       { allow read, write: if isOwner(); }
    match /focusSessions/{sessionId} { allow read, write: if isOwner(); }

    // ── collectionGroup queries ──
    match /{path=**}/projects/{projectId} {
      allow read: if isOwner();
    }
    match /{path=**}/tasks/{taskId} {
      allow read: if isOwner();
    }
  }
}
