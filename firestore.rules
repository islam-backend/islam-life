rules_version = '2';

// ════════════════════════════════════════════════════════════════
//  Firestore Security Rules — Acme Studio task manager
//  (same Firebase project as the owner's personal IslamLife app —
//  the legacy Finance/Food sections below are untouched on purpose)
// ════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Task-manager helpers ─────────────────────────────────────
    // Membership is only real if members/{uid} exists. That doc can
    // only ever be SELF-created (see the `create` rule below), and
    // only for an email present in invites/ — never inferred from
    // "this email isn't the owner's" like the old rules did. No
    // Cloud Function is required for this: exists()/get() below can
    // read invites/ during rule evaluation even though invites/ is
    // otherwise fully locked down to clients.
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function memberDoc() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function isMember() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function roleOf() {
      // .lower().trim() tolerates a hand-typed role value in the console
      // (the one-time owner bootstrap) — a stray capital or trailing
      // space here used to mean silent, hard-to-diagnose access denials.
      return memberDoc().data.role is string ? memberDoc().data.role.lower().trim() : '';
    }

    function isOwner() {
      return isMember() && roleOf() == 'owner';
    }

    // A "manager" is a scoped owner: pick a set of whole CLIENTS for them
    // (managedClientIds on their member doc) and inside those clients they
    // act exactly like the owner — create projects, create/assign/delete
    // tasks, invite plain members. Outside those clients they are just a
    // member (read + their own assigned tasks, nothing more).
    function isManager() {
      return isMember() && roleOf() == 'manager';
    }

    function managesClient(clientId) {
      return isManager()
          && memberDoc().data.managedClientIds is list
          && clientId in memberDoc().data.managedClientIds;
    }

    function canManageClient(clientId) {
      return isOwner() || managesClient(clientId);
    }

    // Same check, but from a task/doc that carries a denormalized clientId
    // (used in the collectionGroup rules where the path has no clientId).
    function managesDocClient(data) {
      return isManager()
          && data.clientId is string
          && memberDoc().data.managedClientIds is list
          && data.clientId in memberDoc().data.managedClientIds;
    }

    function isAssignedToMe(taskData) {
      return taskData.assigneeUids is list
          && request.auth.uid in taskData.assigneeUids;
    }

    // ── Invites (allowlist) — the owner manages these from the app's
    // Admin → Team page. A manager can invite too, but only ever plain
    // members (never another manager or an owner).
    // Every invite is stamped with its real inviter + their role — that's
    // what scopes a manager's audit log to "their people" later on.
    match /invites/{email} {
      // The invitee may read their own invite on first sign-in, to copy
      // invitedBy onto their new member doc (checked in members/ create).
      allow read:           if isOwner() || isManager()
          || (isSignedIn() && request.auth.token.email == email);
      allow create, update: if (isOwner()
          || (isManager() && request.resource.data.role == 'member'))
          && request.resource.data.invitedBy == request.auth.uid
          && request.resource.data.invitedByRole == roleOf();
      allow delete:         if isOwner() || isManager();
    }

    // ── Workspace setup marker ─────────────────────────────────
    // setup/workspace existing = "this workspace already has an owner".
    // Created exactly once: either together with the first owner's member
    // doc (see the owner-claim rule under members/), or by an existing
    // owner on a workspace that predates this marker. Never updated or
    // deleted from a client — that's what keeps the owner claim closed.
    match /setup/{docId} {
      allow read: if isSignedIn();
      allow create: if docId == 'workspace'
          && isSignedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && (isOwner()
              || getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'owner');
    }

    // ── Members ─────────────────────────────────────────────────
    match /members/{uid} {
      // A brand-new user has to be able to check "does my own member
      // doc exist yet?" BEFORE they are a member — isMember() alone
      // would be circular here (it requires the doc to already exist).
      allow read: if isMember() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isOwner();

      // A manager may adjust which projects a member can see, but must
      // never touch anyone's role/email (no self- or cross-promotion) —
      // `diff().affectedKeys()` only lists keys whose value actually
      // changed, so re-writing an unchanged role still passes.
      allow update: if isManager()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['assignedProjects', 'updatedAt'])
          && request.resource.data.role == resource.data.role;

      // First-ever sign-in: a signed-in Google account may create ITS
      // OWN member doc, but only if its email is on the invite list,
      // and only ever as role 'member' — nobody can self-promote to
      // owner this way (the owner comes from the one-time first-run
      // claim below). This is the entire "invite-only" gate — no Cloud Function,
      // no Identity Platform / billing account needed.
      allow create: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == 'member'
          && exists(/databases/$(database)/documents/invites/$(request.auth.token.email))
          // invitedBy / invitedByRole must be copied verbatim from the invite
          // (absent on both is fine — an older invite).
          && request.resource.data.get('invitedBy', null)
              == get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.get('invitedBy', null)
          && request.resource.data.get('invitedByRole', null)
              == get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.get('invitedByRole', null)
          && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'avatarUrl', 'totpEnrolled', 'assignedProjects', 'invitedBy', 'invitedByRole', 'createdAt', 'updatedAt']);

      // First-run owner claim on a brand-new workspace: the very first
      // account to sign in may create its own doc as 'owner' — but only
      // while setup/workspace doesn't exist, and only in the same batch
      // that creates it naming this uid. Once that doc exists (it can
      // never be updated or deleted from a client) this path is closed
      // for good, so exactly one account can ever claim a workspace.
      allow create: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == 'owner'
          && !exists(/databases/$(database)/documents/setup/workspace)
          && getAfter(/databases/$(database)/documents/setup/workspace).data.ownerUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'avatarUrl', 'totpEnrolled', 'assignedProjects', 'createdAt', 'updatedAt']);

      // Self-service edit: a member may update their own profile
      // fields, but never their own role or email.
      allow update: if isMember() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'avatarUrl', 'avatarPath', 'fcmToken', 'fcmTokenUpdatedAt', 'totpEnrolled', 'updatedAt']);
    }

    // ── Clients & Projects ─────────────────────────────────────
    match /clients/{clientId} {
      allow read:          if isMember();
      // Only the owner spins up or tears down a whole client. A manager
      // works INSIDE a client (rename / avatar), never creates one.
      allow create, delete: if isOwner();
      allow update:        if canManageClient(clientId);

      match /projects/{projectId} {
        allow read:  if isMember();
        allow write: if canManageClient(clientId);

        match /tasks/{taskId} {
          // Owner + managing manager: full access. Member: read + status-only
          // update on their own tasks.
          // The member branch is inlined (not isAssignedToMe()) and skips the
          // `is list` guard on purpose — Firestore's query-safety prover only
          // recognizes a query as provably safe when the rule's condition is
          // a bare `request.auth.uid in resource.data.field` matching the
          // query's own `array-contains` filter; wrapping it in a helper
          // function or adding an extra `is list` conjunct breaks that
          // pattern match and the whole `list` request comes back
          // permission-denied — even though a plain get() of the same
          // document would've been allowed.
          allow read:   if canManageClient(clientId)
              || (isMember() && request.auth.uid in resource.data.assigneeUids);
          allow create, delete: if canManageClient(clientId);
          // An assigned member may move the workflow status and set the
          // Notion-style fields (priority / tags / start date) — never
          // reassign, rename, or change the due date. Archiving/restoring is
          // owner/manager only, so a member can't move a task into or out of
          // 'archived', nor touch one that's archived.
          allow update: if canManageClient(clientId)
              || (isMember() && isAssignedToMe(resource.data)
                  && resource.data.status != 'archived'
                  && request.resource.data.status != 'archived'
                  && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['status', 'priority', 'tags', 'startDate', 'updatedAt']));

          match /subtasks/{subtaskId} {
            allow read:   if canManageClient(clientId) || (isMember() && isAssignedToMe(get(/databases/$(database)/documents/clients/$(clientId)/projects/$(projectId)/tasks/$(taskId)).data));
            allow write:  if canManageClient(clientId);
            allow update: if isMember()
                && isAssignedToMe(get(/databases/$(database)/documents/clients/$(clientId)/projects/$(projectId)/tasks/$(taskId)).data)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done']);
          }

          match /comments/{commentId} {
            allow read:   if canManageClient(clientId) || (isMember() && isAssignedToMe(get(/databases/$(database)/documents/clients/$(clientId)/projects/$(projectId)/tasks/$(taskId)).data));
            allow write:  if canManageClient(clientId);
            allow create: if isMember()
                && isAssignedToMe(get(/databases/$(database)/documents/clients/$(clientId)/projects/$(projectId)/tasks/$(taskId)).data)
                && request.resource.data.authorUid == request.auth.uid;
            // Any member can edit the text of their OWN messages (never reassign authorship).
            allow update: if isMember()
                && isAssignedToMe(get(/databases/$(database)/documents/clients/$(clientId)/projects/$(projectId)/tasks/$(taskId)).data)
                && resource.data.authorUid == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']);
            // Any assigned member may react to ANY message — only the
            // `reactions` map may change.
            allow update: if isMember()
                && isAssignedToMe(get(/databases/$(database)/documents/clients/$(clientId)/projects/$(projectId)/tasks/$(taskId)).data)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
          }

          match /attachments/{attachmentId} {
            allow read:   if canManageClient(clientId)
                || (isMember() && isAssignedToMe(get(/databases/$(database)/documents/clients/$(clientId)/projects/$(projectId)/tasks/$(taskId)).data));
            allow create: if canManageClient(clientId)
                || (isMember()
                    && isAssignedToMe(get(/databases/$(database)/documents/clients/$(clientId)/projects/$(projectId)/tasks/$(taskId)).data)
                    && request.resource.data.createdBy == request.auth.uid);
            allow delete: if canManageClient(clientId);
          }
        }
      }
    }

    // ── In-app notifications — self-read, self-mark-as-read ─────────
    // Created by the app (lib/activityLog.ts) for OTHER people when you act:
    // always in your own name, unread, never to yourself. The recipient can
    // only flip `read` — nobody can edit or delete one.
    match /members/{uid}/notifications/{notifId} {
      allow read:   if isSignedIn() && request.auth.uid == uid;
      allow create: if isMember()
          && uid != request.auth.uid
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // ── Audit log — appended by the app with each action (lib/activityLog.ts).
    // Every entry is pinned to its real author (actorUid == you) and a
    // server timestamp; nobody can edit or delete one afterwards.
    //
    // Each entry also carries who invited its author (actorInvitedBy) and
    // that inviter's role (actorInviterRole: 'owner' / 'manager', or 'none'
    // when the author is an owner) — both derived here from the author's own
    // member doc, so they can't be faked. A member who joined before
    // invitedBy existed counts as the owner's.
    //
    // Owner reads everything. A manager reads only "their people":
    //   · their own actions
    //   · actions by people THEY invited
    //   · actions by people the OWNER invited — only if the owner turned on
    //     auditSeesOwnerInvitees for them
    // Each branch backs one list query in useAuditLog, so they're written
    // inline on resource.data (see the collection-group tasks rule for why).
    match /auditLog/{entryId} {
      allow read: if isOwner()
          || (isManager() && (
              resource.data.actorUid == request.auth.uid
              || resource.data.actorInvitedBy == request.auth.uid
              || (resource.data.actorInviterRole == 'owner'
                  && memberDoc().data.get('auditSeesOwnerInvitees', false) == true)));
      allow create: if isMember()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.get('actorInvitedBy', null) == memberDoc().data.get('invitedBy', null)
          && request.resource.data.get('actorInviterRole', null)
              == (roleOf() == 'owner' ? 'none' : memberDoc().data.get('invitedByRole', 'owner'));
      allow update, delete: if false;
    }

    // ── Focus sessions — self-only, owner can see everyone's ───────
    match /focusSessions/{sessionId} {
      allow read:   if isOwner() || (isMember() && resource.data.uid == request.auth.uid);
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    // ── collectionGroup queries (Calendar + Admin "All Assignments") ─
    match /{path=**}/projects/{projectId} {
      allow read: if isMember();
    }
    match /{path=**}/tasks/{taskId} {
      // See the same-shaped rule under clients/*/projects/*/tasks/* above for
      // why the member branch is inlined instead of calling isAssignedToMe().
      allow read: if isOwner()
          || managesDocClient(resource.data)
          || (isMember() && request.auth.uid in resource.data.assigneeUids);
      // This match also covers every clients/*/projects/*/tasks/* doc, so it
      // must carry the same archive guard or it'd be a way around it.
      allow update: if isMember() && isAssignedToMe(resource.data)
          && resource.data.status != 'archived'
          && request.resource.data.status != 'archived'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'priority', 'tags', 'startDate', 'updatedAt']);
    }
    // Owner-only collectionGroup over every task's chat — powers the
    // owner's "new message anywhere" sound/notification listener.
    // Members never run this query; they listen per assigned task instead.
    match /{path=**}/comments/{commentId} {
      allow read: if isOwner();
    }

    // ════════════════════════════════════════════════════════════
    //  LEGACY — islam.walied's personal data. Left exactly as it was
    //  before this rebuild. Deliberately NOT switched to the new
    //  role-based isOwner() above, so future team growth can never
    //  accidentally expose personal finance/health data.
    // ════════════════════════════════════════════════════════════
    function isLegacyOwner() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email == 'islam.walied96@gmail.com';
    }

    match /meta/{docId}          { allow read, write: if isLegacyOwner(); }

    match /accounts/{id}         { allow read, write: if isLegacyOwner(); }
    match /budgetCategories/{id} { allow read, write: if isLegacyOwner(); }
    match /goals/{id}            { allow read, write: if isLegacyOwner(); }
    match /debts/{id}            { allow read, write: if isLegacyOwner(); }
    match /assets/{id}           { allow read, write: if isLegacyOwner(); }
    match /gold_assets/{id}      { allow read, write: if isLegacyOwner(); }
    match /transactions/{id}     { allow read, write: if isLegacyOwner(); }

    match /users/{userId}/food/{docId} {
      allow read, write: if isLegacyOwner();
    }
  }
}
