rules_version = '2';

// ════════════════════════════════════════════════════════════════
//  Firestore Security Rules — islam.walied dashboard
// ════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────
    function isOwner() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email == 'islam.walied96@gmail.com';
    }

    // A team member: verified Google account whose email exists in teamMembers
    function isMember() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email != 'islam.walied96@gmail.com';
    }

    // Task is assigned to the currently-authenticated member
    function assignedToMe() {
      return resource.data.get(['assignedTo', 'email'], '') == request.auth.token.email;
    }

    // ── Team Members ───────────────────────────────────────────
    match /teamMembers/{memberId} {
      allow read:  if isOwner() || (isMember() && resource.data.email == request.auth.token.email);
      allow write: if isOwner();
    }

    // ── Clients & Projects ─────────────────────────────────────
    match /clients/{clientId} {
      allow read, write: if isOwner();

      match /projects/{projectId} {
        allow read, write: if isOwner();

        match /tasks/{taskId} {
          // Owner: full access. Member: read + status-only update on their tasks.
          allow read:   if isOwner() || (isMember() && assignedToMe());
          allow write:  if isOwner();
          allow update: if isMember() && assignedToMe()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

          match /subtasks/{subtaskId} {
            allow read:   if isOwner() || (isMember() && assignedToMe());
            allow write:  if isOwner();
            allow update: if isMember() && assignedToMe()
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done']);
          }

          match /comments/{commentId} {
            allow read:   if isOwner() || (isMember() && assignedToMe());
            allow write:  if isOwner();
            allow create: if isMember() && assignedToMe()
                && request.resource.data.authorEmail == request.auth.token.email;
          }
        }
      }
    }

    // ── App metadata + focus sessions ──────────────────────────
    match /meta/{docId}       { allow read, write: if isOwner(); }
    match /focusSessions/{sessionId} { allow read, write: if isOwner(); }

    // ── Finance (legacy — kept for data safety) ────────────────
    match /accounts/{id}         { allow read, write: if isOwner(); }
    match /budgetCategories/{id} { allow read, write: if isOwner(); }
    match /goals/{id}            { allow read, write: if isOwner(); }
    match /debts/{id}            { allow read, write: if isOwner(); }
    match /assets/{id}           { allow read, write: if isOwner(); }
    match /gold_assets/{id}      { allow read, write: if isOwner(); }
    match /transactions/{id}     { allow read, write: if isOwner(); }

    // ── Food & Health ──────────────────────────────────────────
    match /users/{userId}/food/{docId} {
      allow read, write: if isOwner();
    }

    // ── collectionGroup queries ────────────────────────────────
    match /{path=**}/projects/{projectId} {
      allow read: if isOwner();
    }
    match /{path=**}/tasks/{taskId} {
      // Owner: all tasks. Member: only their assigned tasks.
      allow read:   if isOwner() || (isMember() && resource.data.get(['assignedTo', 'email'], '') == request.auth.token.email);
      allow update: if isMember()
          && resource.data.get(['assignedTo', 'email'], '') == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
  }
}
